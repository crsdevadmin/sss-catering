# Generate separate Test and Live keys in the Razorpay Dashboard.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Choose a long, random value and enter the same value when creating the
# Razorpay webhook. Never expose either secret in browser code.
RAZORPAY_WEBHOOK_SECRET=replace_me

PORT=3000
DATA_DIR=./data

# Cloud Run uses Firestore automatically. Set this locally only when testing
# against a Google Cloud project with Application Default Credentials.
# STORAGE_BACKEND=firestore

# Comma-separated browser origins allowed to call the payment API.
ALLOWED_ORIGINS=https://ssscatering.com,https://www.ssscatering.com,https://crsdevadmin.github.io
